<?xml version="1.0" encoding="UTF-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootRace"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- Background 2 image để seamless scrolling -->
    <ImageView
        android:id="@+id/bgImage1"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:src="@drawable/bg_track" />
    <ImageView
        android:id="@+id/bgImage2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_track" />
    <!-- Vạch đích -->
    <View
        android:id="@+id/finishLine"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@android:color/white"
        android:visibility="gone" />
    <!-- Lanes chứa SeekBar + ImageView ngựa -->
    <LinearLayout
        android:id="@+id/laneContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="32dp">
        <FrameLayout
            android:id="@+id/lane1"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="4dp" />
        <FrameLayout
            android:id="@+id/lane2"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="4dp" />
        <FrameLayout
            android:id="@+id/lane3"
            android:layout_width="match_parent"
            android:layout_height="80dp" />
        <FrameLayout
            android:id="@+id/lane4"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="4dp" />
    </LinearLayout>
    <!-- User Balance and Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_margin="16dp"
        android:orientation="horizontal">
        <!-- Nhóm các nút âm thanh -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginRight="8dp">
            <!-- Nút bài hát trước đó -->
            <Button
                android:id="@+id/btnPreviousTrack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_previous_track_selector"
                android:layout_marginRight="4dp" />
            <!-- Sound toggle button -->
            <ToggleButton
                android:id="@+id/btnToggleSound"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_sound_selector"
                android:textOff=""
                android:textOn="" />
            <!-- Nút bài hát tiếp theo -->
            <Button
                android:id="@+id/btnNextTrack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_next_track_selector"
                android:layout_marginLeft="4dp" />
        </LinearLayout>
        <Button
            android:id="@+id/btnDeposit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nạp tiền"
            android:textColor="@android:color/white"
            android:backgroundTint="#FF9800"
            android:layout_marginRight="8dp"
            android:padding="8dp" />
        <Button
            android:id="@+id/btnPlaceBet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:backgroundTint="#4CAF50"
            android:padding="8dp"
            android:text="Đặt cược"
            android:textColor="@android:color/white" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvUserBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:padding="8dp"
        android:text="Balance: $1000"
        android:layout_gravity="top|end"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="75dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
    <!-- Combined prepare/start race button -->
    <Button
        android:id="@+id/btnRaceAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|bottom"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/design_default_color_secondary_variant"
        android:text="Prepare Race"
        android:textColor="@android:color/white" />
</FrameLayout>