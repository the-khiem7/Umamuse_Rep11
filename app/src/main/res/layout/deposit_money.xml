<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1D79BF"
    tools:context=".DepositMoneyActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/rounded_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <!-- Nhóm các nút âm thanh -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginRight="8dp">
                <!-- Nút bài hát trước đó -->
                <Button
                    android:id="@+id/btnPreviousTrack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_previous_track_selector"
                    android:layout_marginRight="4dp" />
                <!-- Sound toggle button -->
                <ToggleButton
                    android:id="@+id/btnToggleSound"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_sound_selector"
                    android:textOff=""
                    android:textOn="" />
                <!-- Nút bài hát tiếp theo -->
                <Button
                    android:id="@+id/btnNextTrack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_next_track_selector"
                    android:layout_marginLeft="4dp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnTrolai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#59A711"
                android:fontFamily="sans-serif-medium"
                android:text="Quay lại"
                android:textColor="#FFFFFF"
                android:drawableStart="@android:drawable/ic_menu_revert"
                android:drawablePadding="8dp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"

                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Hết tiền rồi chứ chi =))"
                android:textAlignment="center"
                android:textColor="#750E0E"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Current Balance Display -->
        <TextView
            android:id="@+id/tvCurrentBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your current balance: $1000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#006400"
            android:background="#E8F5E9"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:gravity="center" />
        <!-- Packages Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="3">
            <!-- Package 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/textView19"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌱 Return Pack"
                        android:textAlignment="center"
                        android:textColor="#1D3557"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="$100"
                        android:textAlignment="center"
                        android:textColor="#FF5722"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textView20"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="10dp"
                        android:text="Làm giàu trở lại từ cái nịt quần!"
                        android:textAlignment="center"
                        android:textColor="#333333"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- Package 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/textView25"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚡ Comeback Pack"
                        android:textAlignment="center"
                        android:textColor="#1D3557"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="$550"
                        android:textAlignment="center"
                        android:textColor="#FF5722"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textView26"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="10dp"
                        android:text="Cược là đam mê, nạp là lẽ sống!"
                        android:textAlignment="center"
                        android:textColor="#333333"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- Package 3 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/textView29"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👑 God of Bet Pack"
                        android:textAlignment="center"
                        android:textColor="#1D3557"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="$1200"
                        android:textAlignment="center"
                        android:textColor="#FF5722"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textView30"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="10dp"
                        android:text="Thể thao mà không có cá độ là thể dục!"
                        android:textAlignment="center"
                        android:textColor="#333333"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <!-- Radio Button Selection Section -->
        <RadioGroup
            android:id="@+id/radioBtn_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:background="#E297C9BD"
            android:gravity="center">
            <RadioButton
                android:id="@+id/radBtn1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Gói $100"
                android:textSize="16sp"
                android:checked="true"
                android:textColor="#1D3557" />
            <RadioButton
                android:id="@+id/radBtn2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Gói $550"
                android:textSize="16sp"
                android:textColor="#120505" />
            <RadioButton
                android:id="@+id/radBtn3"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Gói $1200"
                android:textSize="16sp"
                android:textColor="#1D3557" />
        </RadioGroup>
        <!-- Purchase Button -->
        <Button
            android:id="@+id/btnClickMua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="40dp"
            android:paddingVertical="12dp"
            android:backgroundTint="#FF1493"
            android:text="Xác nhận nạp tiền"
            android:textSize="18sp"
            android:drawableStart="@android:drawable/ic_menu_send"
            android:drawablePadding="8dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>